# CDNz – نمونه فایل تنظیمات محیط
# این فایل را کپی کنید به .env و مقادیر را پر کنید.
# cp .env.example .env

# ---------- دیتابیس ----------
DB_HOST=localhost
DB_NAME=cdnz
DB_USER=root
DB_PASS=
DB_CHARSET=utf8mb4

# ---------- SMTP (ایمیل: تأیید ثبت‌نام، بازنشانی رمز، اعلان ورود) ----------
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@yourdomain.com
SMTP_FROM_NAME=CDNz

# ---------- merchant_id زرین‌پال در پنل ادمین (تنظیمات) ذخیره می‌شود، نه اینجا ----------
